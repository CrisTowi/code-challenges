---
import "../styles/global.css";
import { challenges } from "../lib/challenges";

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>code challenges</title>
  </head>
  <body>
    <main class="layout">
      <header class="header">
        <div class="header__brand">code<span>::</span>challenges</div>
        <p class="muted" style="margin: 0.5rem 0 0 0; font-size: 1.1rem;">
          ▸ weekly challenges, visualized step-by-step.
        </p>
      </header>

      <div>
        <div class="subtitle">▸ available challenges</div>

        <div class="search">
          <label class="search__label" for="challenge-search">▸ search</label>
          <input
            id="challenge-search"
            class="search__input"
            type="search"
            placeholder="filter by name, description, or slug..."
            autocomplete="off"
            spellcheck="false"
          />
          <span class="search__count" id="challenge-count"></span>
        </div>

        <ul class="challenge-list" id="challenge-list">
          {challenges.map((c) => (
            <li
              class="challenge-list__item"
              data-search={`${c.slug} ${c.title} ${c.description}`.toLowerCase()}
            >
              <a href={`${base}challenges/${c.slug}/`}>
                <h2>{c.title}</h2>
                <p>{c.description}</p>
              </a>
            </li>
          ))}
        </ul>

        <p class="search__empty" id="challenge-empty" hidden>
          ▸ no challenges match your search
        </p>
      </div>
    </main>

    <script>
      const input = document.getElementById("challenge-search") as HTMLInputElement | null;
      const items = Array.from(
        document.querySelectorAll<HTMLLIElement>("#challenge-list .challenge-list__item"),
      );
      const empty = document.getElementById("challenge-empty");
      const count = document.getElementById("challenge-count");
      const total = items.length;

      function applyFilter() {
        if (!input || !empty || !count) return;
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const item of items) {
          const haystack = item.dataset.search ?? "";
          const match = q === "" || haystack.includes(q);
          item.hidden = !match;
          if (match) visible++;
        }
        count.textContent = q === "" ? `${total} total` : `${visible} / ${total}`;
        empty.hidden = visible !== 0 || q === "";
      }

      input?.addEventListener("input", applyFilter);
      applyFilter();
    </script>
  </body>
</html>
